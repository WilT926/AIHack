# Copy to .env.local and fill in. Never commit .env.local.
# Server only: none of these may be read in browser code.

# Supabase (Project settings > API keys). Use the secret key (sb_secret_...).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Optional: lets `npm run db:migrate` create the tables (Connect > Session pooler).
DATABASE_URL=

# Claude, for the assessors.
ANTHROPIC_API_KEY=

# ElevenLabs, for assessor voices (optional; the browser voice is the fallback).
ELEVENLABS_API_KEY=

# Live avatars (optional, off unless 1). Run agent/agent.py beside the app.
LIVE_AVATAR=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
